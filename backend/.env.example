# ── Jobblo backend environment: full reference ───────────────────────────────
# Every variable the API reads, with safe placeholders. Real values NEVER go in git.
#   Local dev : cp .env.development.example .env.development   (then fill the empty secrets)
#   Server    : cp .env.production.example .env.production   on the server only, chmod 600,
#               or set the variables in pm2/systemd. NODE_ENV=production is set by
#               backend/ecosystem.config.js.
# config/env.js reads backend/.env.development (development, test) or backend/.env.production
# (NODE_ENV=production). backend/.env is not read. Real environment variables win over the file.
# Where secrets come from: Stripe Dashboard → Developers (keys, webhook secrets),
# Azure Portal → Storage account → Access keys, Google Cloud / Firebase consoles,
# portal.vipps.no, the Idura dashboard, MongoDB Atlas, OpenAI. Generate JWT_SECRET,
# SESSION_SECRET and MFA_ENCRYPTION_KEY with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A secret that ever reached git, a chat or a screenshot is leaked: rotate it at the
# provider and replace it here — deleting the commit does not un-leak it.

MONGO_URI=

PORT=5001

ALLOWED_ORIGINS=https://jobblo.no,https://www.jobblo.no

AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
# Container WITHOUT anonymous access for evidence and certifications (signed URLs in responses).
# Empty = those files go to the public container above. Set it in production.
AZURE_PRIVATE_CONTAINER=

JWT_SECRET=

# ── Firebase Cloud Messaging ────────────────────────────────────────────────
# Server-only Firebase Admin credentials. Never expose these as EXPO_PUBLIC_*.
# The JSON file must belong to the same Firebase project as the Android app.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
FIREBASE_PROJECT_ID=

# Mobile EAS build only (NOT read by this API): an EAS file secret for jobblo-app.
# It must contain client package_name=com.jobblo.app.
# GOOGLE_SERVICES_JSON=/secure/path/google-services.json
# Alternative to the credentials file: FIREBASE_CONFIG (JSON), as firebase-admin reads it.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALLBACK_URL=
GOOGLE_WEB_CALLBACK_URL=https://jobblo.no/api/auth/web/google/callback
GOOGLE_MOBILE_CALLBACK_URL=https://jobblo.no/api/auth/mobile/google/callback
# Sign in with Apple (iOS app): the identity token audience. Defaults to jobblo-app/app.json ios.bundleIdentifier when the repo is alongside.
APPLE_BUNDLE_ID=com.jobblo.app
# Sign in with Apple, web flow (Android app + website): the Services ID (Apple Developer > Identifiers > Services IDs). Empty = off (start endpoints answer 503).
APPLE_SERVICES_ID=
# Return URL registered on that Services ID (must be https), e.g. https://jobblo.no/api/auth/apple/callback
APPLE_REDIRECT_URI=
FRONTEND_URL=https://jobblo.no


# ── Stripe ───────────────────────────────────────────────────────────────────
# The mode is chosen by the STRIPE_TEST_MODE flag in the Superadmin "Abonnementer"
# page. There is NO fallback between the two sets below: whichever mode is active
# must have BOTH its secret key and its webhook secret set, or Stripe calls throw
# and webhook events are rejected. That is deliberate — silently borrowing the live
# key during a test run would take real money.
#
# The admin badge reports the mode of the key actually in use (sk_test_ / sk_live_),
# not the toggle, so a mismatch is visible rather than misleading.

# LIVE mode (STRIPE_TEST_MODE = false)
STRIPE_SECRET_KEY=
# Signing secret for the LIVE webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# TEST mode (STRIPE_TEST_MODE = true)
STRIPE_TEST_SECRET_KEY=
# Signing secret for the TEST webhook endpoint. This is a DIFFERENT value from the
# live one, and `stripe listen` prints a different one again for each CLI session.
STRIPE_TEST_WEBHOOK_SECRET=

# Subscription billing policy:
# - Checkout starts a monthly anniversary-based cycle (not first-of-month aligned).
# - Upgrades apply immediately with Stripe's prorated invoice; the change only
#   affects Jobblo entitlements after the verified subscription webhook.
# - Downgrades take effect at period end with no early proration.
# - Stripe Billing Smart Retries and retry cadence are configured in the Stripe
#   Dashboard. The app never cancels a subscription after one failed attempt.
#   The grace window is the v2 recovery policy (SUBSCRIPTION_V2_* below), not an env number.

# Webhook endpoint to register in the Stripe dashboard, for BOTH modes:
#   POST <API_URL>/api/stripe/webhook
#   API version: 2025-12-15.clover  (must match config/stripe.js)
#   Events: checkout.session.completed, checkout.session.expired,
#           invoice.paid, invoice.payment_failed,
#           customer.subscription.updated, customer.subscription.deleted,
#           customer.subscription.paused, customer.subscription.resumed,
#           customer.subscription.pending_update_applied,
#           customer.subscription.pending_update_expired,
#           subscription_schedule.completed, subscription_schedule.canceled,
#           invoice.payment_action_required,
#           transfer.created, transfer.updated, transfer.reversed,
#           payout.created, payout.updated, payout.paid,
#           payout.failed, payout.canceled
# For Stripe Connect activity, enable events on connected accounts for this same
# endpoint. Keep test and live endpoints/mode-specific signing secrets separate.
# A configured whsec_ value alone does not prove Stripe delivered a signed event:
# verify setup by sending a legitimate test event and checking the backend's
# signature-verification and processing logs before enabling live payments.
# The legacy path POST <API_URL>/api/safepay-checkout/webhook still works and is
# handled by the same dispatcher, so an endpoint already registered there keeps
# functioning.
#
# No additional environment variables are required for the read-only Stripe
# transfer and bank-payout history pages; they use the mode-specific API keys,
# connected-account IDs, and webhook signing secrets above.
#
# Without the matching secret the handler returns 503 for every event, and a
# payment whose browser redirect never came back is captured by Stripe but never
# recorded in Jobblo.

# ── Mobile app return trip ────────────────────────────────────────────────────
# Read whenever the app asks for a mobile return trip: SafePay checkout
# (POST /api/safepay-checkout/create-session with { platform: "mobile" }) and OAuth
# sign-in (GET /api/auth/google|vipps?platform=mobile — see utils/oauthReturn.js).
# Neither Stripe nor an OAuth provider accepts a custom scheme as a redirect target, so
# both return to an HTTPS page on THIS server, which then hands off to the app. Web
# checkouts and web sign-ins keep using FRONTEND_URL and ignore both of these.
#
# Public origin of this API. REQUIRED in production: the Host header is client-supplied,
# so it is not trusted there and create-session returns 500 rather than letting a caller
# choose where Stripe sends a customer. Outside production the request origin is used, so
# a LAN dev server needs no setup. No trailing slash.
MOBILE_RETURN_URL=
# The scheme the bridge page hands off to. Defaults to jobblo:// which matches
# jobblo-app/app.json. Must NOT be an http(s) URL — this is an app hand-off, not a general
# redirector. Expo Go does not register the app's own scheme, so to test there set this to
# your dev server instead, e.g. exp://192.168.1.10:8081/--/ (never ship that value).
MOBILE_APP_LINK_PREFIX=jobblo://
#
# Run `node scripts/check-payment-config.js` to verify all of the above on this machine.

# Review window before an order sitting in ready_for_review is auto-released to the
# provider by the scheduler. Days. Conservative default if unset: 14.
SAFEPAY_AUTO_RELEASE_DAYS=14
# Warn the customer this many days before auto-release (default 3).
SAFEPAY_AUTO_RELEASE_WARN_DAYS=3
# Unpaid checkout orders are cancelled after this many hours (default 72).
SAFEPAY_ABANDONED_ORDER_HOURS=72
# Dev/test only (ignored in production): shorten the provider Stripe-Connect deadline to N minutes.
SAFEPAY_CONNECT_TEST_DEADLINE_MINUTES=
# Hast (39 kr), in minutes (default 4320 = 3 days). A published job keeps «Haster» this long;
# a Hast paid but never published (or its draft deleted) is refunded after the same time.
# A small value (e.g. 3) lets you test both locally; the checks then run every minute.
HAST_DURATION_MINUTES=
# Set to 'false' to disable the background scheduler entirely (e.g. on a second
# instance, so only one process runs the jobs).
ENABLE_SCHEDULER=true

# ── Vipps Login (OpenID Connect) ─────────────────────────────────────────────
# CLIENT_ID, CLIENT_SECRET, SUB_KEY and REDIRECT_URI must all be set for the Vipps
# button to complete. A missing client id or redirect uri makes the start endpoint
# answer `oauth_failed` before the browser ever leaves.
#
# VIPPS_BASE_URL       https://apitest.vipps.no for the TEST environment,
#                      https://api.vipps.no for production. The three credentials
#                      below belong to ONE environment: test keys against
#                      api.vipps.no (or the reverse) fail the token exchange.
# VIPPS_CLIENT_ID      "Client ID" of the Login sales unit in portal.vipps.no.
# VIPPS_CLIENT_SECRET  Shown once when the Login credentials are created.
# VIPPS_SUB_KEY        Subscription key, sent as Ocp-Apim-Subscription-Key.
# VIPPS_WEB_REDIRECT_URI   Must match a redirect URI registered in the Vipps portal
#                         EXACTLY (no wildcards) AND point at the server that started
#                         the flow — it is replayed on the token exchange, so a value
#                         belonging to another deployment hands the code to a server
#                         whose session knows nothing about it (`vipps_invalid_state`).
#                         Testing from a phone therefore needs this machine's public
#                         HTTPS origin, not production and not localhost:
#                           https://<your-tunnel>.ngrok-free.dev/api/auth/web/vipps/callback
#                         Production: https://www.jobblo.no/api/auth/web/vipps/callback
# VIPPS_MOBILE_REDIRECT_URI is the APK route and must match the mobile callback URL.
VIPPS_BASE_URL=https://api.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUB_KEY=
VIPPS_WEB_REDIRECT_URI=https://jobblo.no/api/auth/web/vipps/callback
VIPPS_MOBILE_REDIRECT_URI=https://jobblo.no/api/auth/mobile/vipps/callback
VIPPS_REDIRECT_URI=


# Cloudinary retired — image storage moved to Azure Blob.
# Set AZURE_STORAGE_CONNECTION_STRING and AZURE_CONTAINER_NAME (near the top).

# Email (SMTP) - for Forgot Password emails
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# production on the server (backend/ecosystem.config.js sets it for pm2 and wins over this file)
NODE_ENV=development
# ── AI (job-listing Smart Fill) ───────────────────────────────────────────────
# Server-side only. Never expose to the frontend.
OPENAI_API_KEY=sk-...
# Must support strict JSON schema output. gpt-4o-mini is the cheapest that does;
# gpt-3.5-turbo does NOT and produces structurally invalid listings.
OPENAI_MODEL=gpt-4o-mini
# Model for photo-based Smart Fill; defaults to OPENAI_MODEL.
OPENAI_VISION_MODEL=
# Judge model used only by evals/ (never at runtime).
EVAL_JUDGE_MODEL=gpt-4.1

# ─────────────────────────────────────────────────────────────────────────────
# Idura Verify — Norwegian BankID verification (OpenID Connect)
#
# Replaces IDURA_BASE_URL / IDURA_CALLBACK_URL, which belonged to the removed
# bespoke implementation and did not describe an OIDC client.
#
# All four must be set for BankID verification to be offered; when any is missing the routes
# answer with `bankid_unavailable` and the UI hides the option. Nothing here is
# secret in this file — put real values in .env, which is not committed.
#
# IDURA_ISSUER      The tenant domain from the Idura dashboard. Test domains look
#                   like <tenant>.test.idura.broker. Scheme optional; https is
#                   assumed. This is the OIDC issuer — discovery reads
#                   <issuer>/.well-known/openid-configuration.
# IDURA_CLIENT_ID   The application's "Client ID / Realm" from the dashboard,
#                   e.g. urn:my:application:identifier:123
# IDURA_CLIENT_SECRET  Shown once at application creation and not retrievable
#                   afterwards. Required because this is a confidential
#                   (server-side) client; PKCE is used in addition, not instead.
# IDURA_REDIRECT_URI   Must match a Redirect URL registered in the dashboard
#                   exactly — no wildcards are supported.
# IDURA_ACR_VALUES  Optional. No code-level default is applied. When omitted,
#                   Idura uses the methods configured in the dashboard and may
#                   display its method selector. Set this only to bypass that selector:
#                     urn:grn:authn:no:bankid              kodebrikke
#                     urn:grn:authn:no:bankid:high         kodebrikke, high
#                     urn:grn:authn:no:bankid:substantial  BankID Biometrics
#
# The `ssn` scope is deliberately NOT requested and must not be enabled: Jobblo
# stores no Norwegian national identity number. See utils/iduraIdentity.js.
IDURA_ISSUER=your-tenant.test.idura.broker
IDURA_CLIENT_ID=urn:my:application:identifier:0000
IDURA_CLIENT_SECRET=
IDURA_REDIRECT_URI=http://localhost:5001/api/auth/idura/callback
# IDURA_REDIRECT_URI=https://distant-hence-upstairs.ngrok-free.dev/api/auth/idura/callback
# IDURA_ACR_VALUES=urn:grn:authn:no:bankid

# Signs the session cookie AND encrypts session contents at rest in MongoDB.
# The BankID flow keeps a PKCE code_verifier in the session between the redirect
# and the callback, so this is no longer only a cookie-integrity concern.
SESSION_SECRET=

# Canonical public site origin, used for og:url and shared links.
PUBLIC_SITE_URL=https://jobblo.no

# ── Database backups (developer dashboard → Backup & DR; docs/runbooks/disaster-recovery.md)
# Directory for mongodump archives — outside the app folder and NOT on a web-served path.
BACKUP_DIR=
# Paths to MongoDB Database Tools if they are not on PATH.
MONGODUMP_BIN=
MONGORESTORE_BIN=
BACKUP_RETENTION_DAYS=14
# Alert when the newest successful backup is older than this (RPO).
BACKUP_MAX_AGE_HOURS=26
# Leave empty to schedule `node scripts/backup.js backup` from host cron (recommended);
# set (e.g. 24) to run backups inside the API process instead.
BACKUP_SCHEDULE_HOURS=
# Offsite copy after each backup, run without a shell; {file} = full path, {name} = file name.
# e.g. rclone copyto {file} jobblo-offsite:jobblo-backups/{name}   (use an rclone "crypt" remote)
BACKUP_OFFSITE_CMD=
# MongoDB Atlas cloud snapshots (read-only service account, Project Read Only role).
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_GROUP_ID=
ATLAS_CLUSTER_NAME=

# ── Synthetic monitoring (developer dashboard → Synthetic Monitoring)
# Probes run every SYNTHETIC_INTERVAL_MIN minutes from this server. Set ENABLE_SYNTHETIC=false to stop them.
ENABLE_SYNTHETIC=
SYNTHETIC_INTERVAL_MIN=5
# Public API URL (e.g. https://api.jobblo.no) so probes also cover nginx + TLS; default http://127.0.0.1:$PORT.
SYNTHETIC_API_URL=
# Web app URL; defaults to PUBLIC_SITE_URL, then FRONTEND_URL.
SYNTHETIC_WEB_URL=
# A dedicated, unprivileged account for the login → profile → logout journey (leave empty to skip).
SYNTHETIC_USER_EMAIL=
SYNTHETIC_USER_PASSWORD=
# Extra hosts custom checks may target (comma-separated host[:port]); our own API/web hosts are always allowed.
SYNTHETIC_ALLOWED_HOSTS=
# Geonorge address-search probe (geocoding health on the External services tab). Set false to disable.
SYNTHETIC_GEO=
# External services quotas shown on the dashboard (optional). Gmail defaults to 500/day.
SMTP_DAILY_QUOTA=
OPENAI_RPM_LIMIT=
# Mobile release management: oldest supported app version (shown as 'below minimum' on the Mobile App page).
MOBILE_MIN_VERSION=
MOBILE_MIN_VERSION_IOS=
MOBILE_MIN_VERSION_ANDROID=
# Test & Quality: CI posts test results to POST /api/quality/report with this token (header X-Quality-Token).
# Off when empty. Put the same value + the endpoint URL in GitHub secrets QUALITY_INGEST_TOKEN / QUALITY_REPORT_URL.
QUALITY_INGEST_TOKEN=
# Release gates (optional): minimum line coverage %, largest allowed drop (points), the release branch.
QUALITY_MIN_COVERAGE=
QUALITY_MAX_COVERAGE_DROP=1
QUALITY_MAIN_BRANCH=main
# Authenticator-app 2FA (required for superAdmin + developer): 32-byte key that encrypts the TOTP secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))". If empty, a key is
# derived from JWT_SECRET — then rotating JWT_SECRET forces every admin to set up their app again.
MFA_ENCRYPTION_KEY=

# SLO latency objective: API requests slower than this (ms) count against the latency error budget.
SLO_LATENCY_MS=1000

# Capacity planning (developer dashboard): measured max requests/second for one API instance,
# and the MongoDB storage cap in GB when on an Atlas tier (leave empty on a VPS).
CAPACITY_MAX_RPS=
CAPACITY_MONGO_LIMIT_GB=

# Staging failure simulator (developer dashboard). NEVER set in production — it is refused there anyway,
# and also when a live Stripe key is in use.
ENABLE_FAILURE_SIMULATOR=

# ── Redis (optional) ───────────────────────────────────────────────────────────
# With REDIS_URL: background jobs on BullMQ (email, push, scheduled jobs — retried, kept as
# dead letters when they keep failing), rate limits shared by all API instances, a shared
# cache and the socket.io Redis adapter. Without it everything runs in-process as before.
# Example: redis://127.0.0.1:6379   or   rediss://:password@host:6380
REDIS_URL=
# Key prefix, so several environments can share one Redis.
REDIS_PREFIX=jobblo
# false = this instance only enqueues jobs; another instance runs the workers.
ENABLE_WORKERS=
# Graceful shutdown deadline in ms (in-flight requests and running jobs get this long).
SHUTDOWN_TIMEOUT_MS=10000
# API worker processes on the one PORT (node:cluster, see cluster.js): empty/1 = one process,
# N or "auto" = one per CPU. Needs REDIS_URL (otherwise it warns and runs 1). Worker 1 runs the
# scheduler and other singletons; socket.io is websocket-only in this mode (no polling fallback).
WEB_CONCURRENCY=
# Round-robin connection hand-off between cluster workers (Node's default on Linux).
NODE_CLUSTER_SCHED_POLICY=rr

# ── Network / proxy ───────────────────────────────────────────────────────────
# Bind address. Production: 127.0.0.1 so only the local nginx reaches PORT. A public bind
# refuses to boot in production unless ALLOW_PUBLIC_HOST=true.
HOST=127.0.0.1
ALLOW_PUBLIC_HOST=
# Which proxy's X-Forwarded-For to trust. Empty = loopback (nginx on the same machine).
# A hop count (1) or a proxy IP/subnet for other topologies.
TRUST_PROXY=
# Swagger UI at /api/docs: always on outside production; in production only when true.
ENABLE_API_DOCS=

# ── Subscriptions v2 (feature flags, all off unless exactly "true") ────────────
SUBSCRIPTION_V2_PLAN_CATALOGUE_ENABLED=
SUBSCRIPTION_V2_CHECKOUT_ENABLED=
SUBSCRIPTION_V2_ENTITLEMENTS_ENABLED=
SUBSCRIPTION_V2_MANAGEMENT_ENABLED=
SUBSCRIPTION_V2_PAID_UPGRADE_RECOVERY_ENABLED=
# Failed-renewal recovery: 7-day grace, the scheduler job, reminder emails, and voiding the
# open invoice when grace ends. Reminder days: comma-separated 1–6 (empty = built-in schedule).
SUBSCRIPTION_V2_GRACE_PERIOD_ENABLED=
SUBSCRIPTION_V2_RECOVERY_JOB_ENABLED=
SUBSCRIPTION_V2_RECOVERY_EMAILS_ENABLED=
SUBSCRIPTION_V2_GRACE_EXPIRY_INVOICE_VOID_ENABLED=
SUBSCRIPTION_V2_RECOVERY_REMINDER_DAYS=

# ── Accounts / sharing ────────────────────────────────────────────────────────
# Accounts created on/after this instant must verify their email before signing in.
EMAIL_PROOF_CUTOFF=2026-10-26T00:00:00Z
# Link-preview image (absolute URL or a path on PUBLIC_SITE_URL).
SOCIAL_SHARE_IMAGE=https://jobblo.no/assets/share-image.png

# ── Developer dashboard: alerts, releases, infrastructure pages ───────────────
# Alert channels (both optional). Slack incoming-webhook URL is a secret.
SLACK_WEBHOOK_URL=
DEV_ALERT_EMAIL=
# MongoDB queries slower than this (ms) are listed on the APM page.
SLOW_QUERY_MS=100
# GitHub Actions status / change risk: a fine-grained read-only token for this repo.
GITHUB_TOKEN=
GITHUB_REPO=abdi4312/jobblo
# Release identity (deploy script sets these; empty = package.json version + git in the checkout).
APP_VERSION=
GIT_COMMIT_SHA=
GIT_BRANCH=
DEPLOYED_AT=
# Nginx page: stub_status URL, the jobblo_json access log, the micro-cache dir, the binary.
NGINX_STATUS_URL=http://127.0.0.1:8090/nginx_status
NGINX_ACCESS_LOG=/var/log/nginx/jobblo.json.log
NGINX_CACHE_DIR=/var/cache/nginx/jobblo
NGINX_BIN=
# PM2 page: path to pm2 when it is not on PATH.
PM2_BIN=
