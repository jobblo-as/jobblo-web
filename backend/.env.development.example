# ── Local development ────────────────────────────────────────────────────────
#   cp .env.development.example .env.development   then fill the empty values you need.
# config/env.js reads backend/.env.development locally (and under jest); production reads .env.production.
# Only what local dev needs or sets differently; every other variable, with its
# explanation, is in .env.example (unset ones fall back to safe defaults).
# Use TEST credentials only here: sk_test_ Stripe keys, a test Vipps/Idura tenant,
# and a local or *-test database — never the production MongoDB.

NODE_ENV=development
PORT=5001
HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017/jobblo-dev

# Any long random strings (different from each other):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=
MFA_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
MOBILE_APP_LINK_PREFIX=jobblo://

# Image uploads (an Azure dev container, or leave empty and skip uploads).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
AZURE_PRIVATE_CONTAINER=

# Stripe: test mode only. Turn STRIPE_TEST_MODE on in Superadmin → Abonnementer.
# Webhooks locally:  stripe listen --forward-to localhost:5001/api/stripe/webhook
# and paste the whsec_ it prints below (it changes per `stripe listen` session).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Sign-in providers (optional locally; leave empty to hide the button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_CALLBACK_URL=http://localhost:5001/api/auth/web/google/callback
GOOGLE_MOBILE_CALLBACK_URL=http://localhost:5001/api/auth/mobile/google/callback
# Sign in with Apple (iOS app): identity token audience; empty = jobblo-app/app.json ios.bundleIdentifier.
APPLE_BUNDLE_ID=
# Sign in with Apple, web flow (Android app + website): the Services ID (Apple Developer > Identifiers > Services IDs). Empty = off (start endpoints answer 503).
APPLE_SERVICES_ID=
# Apple only accepts https return URLs: an https tunnel (ngrok) to this server, e.g. https://<tunnel>/api/auth/apple/callback
APPLE_REDIRECT_URI=
VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUB_KEY=
VIPPS_WEB_REDIRECT_URI=
VIPPS_MOBILE_REDIRECT_URI=
IDURA_ISSUER=your-tenant.test.idura.broker
IDURA_CLIENT_ID=
IDURA_CLIENT_SECRET=
IDURA_REDIRECT_URI=http://localhost:5001/api/auth/idura/callback

# Email: a Gmail app password or a local catcher (e.g. Mailpit on 1025).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis is optional; with it you can run the cluster locally (scripts/local-cluster.ps1).
REDIS_URL=
REDIS_PREFIX=jobblo-dev
WEB_CONCURRENCY=

ENABLE_SCHEDULER=true
# Probes would hit the dev server every 5 minutes; off locally.
ENABLE_SYNTHETIC=false
# Fast Connect-deadline testing (dev only, ignored in production).
SAFEPAY_CONNECT_TEST_DEADLINE_MINUTES=
# Hast (39 kr), in minutes (default 4320 = 3 days). A published job keeps «Haster» this long;
# a Hast paid but never published (or its draft deleted) is refunded after the same time.
# A small value (e.g. 3) lets you test both locally; the checks then run every minute.
HAST_DURATION_MINUTES=

SUBSCRIPTION_V2_PLAN_CATALOGUE_ENABLED=true
SUBSCRIPTION_V2_CHECKOUT_ENABLED=true
SUBSCRIPTION_V2_ENTITLEMENTS_ENABLED=true
SUBSCRIPTION_V2_MANAGEMENT_ENABLED=true

# Staging/dev failure simulator in the developer dashboard (refused in production).
ENABLE_FAILURE_SIMULATOR=
