# ── Production server ────────────────────────────────────────────────────────
# On the SERVER only:  cp .env.production.example .env && chmod 600 .env
# then fill every empty value. Never commit the filled file, never paste it in a
# chat/ticket. Explanations for each variable: .env.example.
# backend/ecosystem.config.js sets NODE_ENV=production for pm2 (it wins over this file).

NODE_ENV=production
PORT=5001
# Only the local nginx may reach the API (a public bind refuses to boot).
HOST=127.0.0.1
TRUST_PROXY=

# MongoDB with a replica set (transactions). mongodb+srv://… for Atlas.
MONGO_URI=

# REQUIRED, each a different 32-byte random hex string. SESSION_SECRET must differ
# from JWT_SECRET or the API refuses to boot. Rotating JWT_SECRET logs everyone out.
JWT_SECRET=
SESSION_SECRET=
MFA_ENCRYPTION_KEY=

FRONTEND_URL=https://jobblo.no
PUBLIC_SITE_URL=https://jobblo.no
ALLOWED_ORIGINS=https://jobblo.no,https://www.jobblo.no
# REQUIRED in production (Stripe/OAuth return to the app go through this origin).
MOBILE_RETURN_URL=https://jobblo.no
MOBILE_APP_LINK_PREFIX=jobblo://

AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
# No anonymous access — evidence and certifications.
AZURE_PRIVATE_CONTAINER=

# LIVE keys (sk_live_…) and the signing secret of the LIVE webhook endpoint
# POST https://jobblo.no/api/stripe/webhook. The TEST pair is only for the
# Superadmin test-mode toggle; leave empty if test mode is never used here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

GOOGLE_APPLICATION_CREDENTIALS=/etc/jobblo/firebase-service-account.json
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_CALLBACK_URL=https://jobblo.no/api/auth/web/google/callback
GOOGLE_MOBILE_CALLBACK_URL=https://jobblo.no/api/auth/mobile/google/callback
APPLE_BUNDLE_ID=com.jobblo.app
VIPPS_BASE_URL=https://api.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUB_KEY=
VIPPS_WEB_REDIRECT_URI=https://jobblo.no/api/auth/web/vipps/callback
VIPPS_MOBILE_REDIRECT_URI=https://jobblo.no/api/auth/mobile/vipps/callback
IDURA_ISSUER=
IDURA_CLIENT_ID=
IDURA_CLIENT_SECRET=
IDURA_REDIRECT_URI=https://jobblo.no/api/auth/idura/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis: shared rate limits, cache, BullMQ jobs, socket.io adapter. Needed for >1 worker.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=jobblo
WEB_CONCURRENCY=auto
NODE_CLUSTER_SCHED_POLICY=rr
ENABLE_SCHEDULER=true
ENABLE_WORKERS=
SHUTDOWN_TIMEOUT_MS=10000

SAFEPAY_AUTO_RELEASE_DAYS=14

# Turn on only what has been released (exactly "true").
SUBSCRIPTION_V2_PLAN_CATALOGUE_ENABLED=
SUBSCRIPTION_V2_CHECKOUT_ENABLED=
SUBSCRIPTION_V2_ENTITLEMENTS_ENABLED=
SUBSCRIPTION_V2_MANAGEMENT_ENABLED=

# Backups (docs/runbooks/disaster-recovery.md): outside the app folder, not web-served.
BACKUP_DIR=/var/backups/jobblo
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
BACKUP_OFFSITE_CMD=

# Monitoring
SYNTHETIC_API_URL=https://jobblo.no
SLACK_WEBHOOK_URL=
DEV_ALERT_EMAIL=
NGINX_STATUS_URL=http://127.0.0.1:8090/nginx_status
NGINX_ACCESS_LOG=/var/log/nginx/jobblo.json.log
NGINX_CACHE_DIR=/var/cache/nginx/jobblo

# Must stay empty/false in production:
ENABLE_API_DOCS=
ENABLE_FAILURE_SIMULATOR=
ALLOW_PUBLIC_HOST=
