# Local dev:  cp .env.development.example .env.development   (Vite loads it for `npm run dev`)
# Everything VITE_* is baked into the public bundle — never put a secret here.
VITE_MAIN_URL=http://localhost:5001
VITE_PUBLIC_SITE_URL=http://localhost:5173
# A Maps key restricted to http://localhost:* referrers.
VITE_GOOGLE_MAPS_API_KEY=
# "Fortsett med Apple" on login/register: true only once the backend has APPLE_SERVICES_ID + APPLE_REDIRECT_URI set. Default hidden.
VITE_APPLE_SIGNIN_ENABLED=
