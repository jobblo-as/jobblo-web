# Production build:  cp .env.production.example .env.production   (Vite loads it for `npm run build`)
# scripts/check-env.mjs fails the build when VITE_MAIN_URL or VITE_GOOGLE_MAPS_API_KEY is empty.
# Everything VITE_* is baked into the public bundle — never put a secret here.
VITE_MAIN_URL=https://jobblo.no
VITE_PUBLIC_SITE_URL=https://jobblo.no
# A Maps key restricted to https://jobblo.no/* and https://www.jobblo.no/* referrers.
VITE_GOOGLE_MAPS_API_KEY=
# "Fortsett med Apple" on login/register: true only once the backend has APPLE_SERVICES_ID + APPLE_REDIRECT_URI set. Default hidden.
VITE_APPLE_SIGNIN_ENABLED=
# Optional: release tag for error reports, AdSense publisher id (ca-pub-…).
VITE_APP_VERSION=
VITE_ADSENSE_CLIENT=
