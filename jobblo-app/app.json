{
  "expo": {
    "name": "Jobblo",
    "slug": "jobblo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "jobblo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobblo.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jobblo.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2E6641",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#EFF0EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#121411"
          }
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Jobblo trenger tilgang til bildene dine slik at du kan legge til bilder av oppdraget, profilbilde og dokumentasjon av utført arbeid. Bilder i en annonse kan brukes av AI-hjelperen til å foreslå tekst.",
          "cameraPermission": "Jobblo bruker kameraet slik at du kan ta bilder av oppdraget og dokumentere utført arbeid. Når du legger ut et oppdrag, gir AI-hjelperen tips om bildene og foreslår tekst til annonsen.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Jobblo bruker kameraet slik at du kan ta bilder av oppdraget og dokumentere utført arbeid. Når du legger ut et oppdrag, gir AI-hjelperen tips om bildene og foreslår tekst til annonsen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jobblo bruker posisjonen din til å plassere oppdraget ditt på kartet og vise oppdrag i nærheten av deg.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
