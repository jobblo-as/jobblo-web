# Jobblo app build-time variables (inlined into the bundle: never put secrets here).
# Local: copy to .env. EAS builds: set them in the EAS environment for the profile.

# API base, e.g. https://jobblo.no/api (dev: http://<lan-ip>:5001/api)
EXPO_PUBLIC_API_URL=
# Google Maps keys (Google Cloud console > APIs & Services > Credentials), restricted per platform
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# Membership/Stripe plan screens (never shown on iOS); true for local dev only
EXPO_PUBLIC_MEMBERSHIP_ENABLED=
# Android "Fortsett med Apple" (Apple's web flow): true only once the backend has APPLE_SERVICES_ID + APPLE_REDIRECT_URI. iOS always uses the native button.
EXPO_PUBLIC_APPLE_WEB_SIGNIN=
